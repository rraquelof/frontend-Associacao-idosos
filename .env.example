# URL da API Back-end (padrão local: http://localhost:3333/api)
VITE_API_URL=http://localhost:3333/api

# Ativa o interceptador de dados simulados no navegador (true | false)
VITE_USE_MOCK=true

# Opcional: chave gratuita da API Google Gemini (caso o backend não tenha GEMINI_API_KEY configurada)
VITE_GEMINI_API_KEY=
